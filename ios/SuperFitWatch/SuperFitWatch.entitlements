<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hand-maintained, like the iOS app's. HealthKit only: CloudKit and Sign
	     in with Apple are deliberately absent (a free Apple team can't sign
	     them). Never let XcodeGen generate this from an `entitlements:` block —
	     it would overwrite this with an empty dict on every run. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
