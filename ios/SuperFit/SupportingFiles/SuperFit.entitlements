<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple and CloudKit are deliberately absent: a free personal
	     Apple team cannot sign either one, and requesting a capability the team
	     can't issue a profile for fails the whole device build rather than
	     degrading. AppSchema.makeContainer already falls back to an on-disk
	     local store, so the data persists — it just doesn't sync.

	     Restoring them needs a paid Apple Developer Program membership:
	         com.apple.developer.applesignin              -> ["Default"]
	         com.apple.developer.icloud-services          -> ["CloudKit"]
	         com.apple.developer.icloud-container-identifiers
	                                                      -> ["iCloud.com.stephenh.superfit"]
	         com.apple.developer.ubiquity-kvstore-identifier
	                          -> $(TeamIdentifierPrefix)$(CFBundleIdentifier) -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
</dict>
</plist>
