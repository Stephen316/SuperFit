# Where this backend is reachable, no trailing slash. Used to build the OAuth
# redirect URI, which MUST equal what you registered with Garmin.
PUBLIC_BASE_URL=https://your-backend.vercel.app

# From your Garmin Health API onboarding pack (developer.garmin.com/health-api).
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# OAuth 2.0 (PKCE) endpoints and scopes. Defaults are the current Garmin values
# but VERIFY them against your onboarding docs — Garmin versions these, and a
# program provisioned for OAuth 1.0a needs the alternative in README.md.
# GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://diauth.garmin.com/di-oauth2-service/oauth/token
# GARMIN_USER_ID_URL=https://apis.garmin.com/wellness-api/rest/user/id
# GARMIN_API_BASE_URL=https://apis.garmin.com
# GARMIN_SCOPES=

# Shared secret appended to the webhook URL you register with Garmin, so only
# Garmin's pushes are accepted: https://your-backend/garmin/webhook?secret=...
WEBHOOK_SECRET=

# Production persistence (required on serverless — see README). Leaving these
# unset falls back to an in-memory store that only survives within one process,
# which is fine for `vercel dev` and the seed test but loses data otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to enable GET /garmin/dev/seed for testing the app↔backend
# contract without a real Garmin account. A separate secret is required even in
# dev so accidentally enabling the route cannot create a public session mint.
DEV_SEED_ENABLED=false
DEV_SEED_SECRET=
