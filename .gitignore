# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
build/
.DS_Store

# SwiftPM
.build/

# Python (windows/)
__pycache__/
*.pyc
dist/
*.spec
.venv/

# Generated by `xcodegen generate` from project.yml — never committed, so it
# cannot drift from the sources or carry references to deleted files.
*.xcodeproj/
*.xcworkspace/

# Local API keys / signing config, if you ever add an xcconfig
Secrets.xcconfig

# graphify knowledge-graph output. Written here by `graphify update`, which
# resolves its output directory against the scanned path rather than the working
# directory. ~14 MB, machine-local, and regenerable — committing it would churn a
# 4.7 MB graph.json through every auto-merge.
graphify-out/

# /pr review marker: the SHA last reviewed. Per-machine on purpose — a tracked
# copy would conflict on every auto-merge between the two machines.
.claude/pr-last-reviewed
