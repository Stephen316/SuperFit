// Copy this file to Secrets.xcconfig and fill in your team, then re-run
// `xcodegen generate`. Secrets.xcconfig is gitignored and never committed.
//
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// Your Team ID is in Xcode > Settings > Accounts (select the team, then
// "Manage Certificates" shows it), or on the Membership page of the Apple
// Developer portal. It looks like a 10-character alphanumeric string.
//
// Only needed for building on a real device. Simulator builds are unsigned.
DEVELOPMENT_TEAM =

// Optional. A free USDA FoodData Central key from
// https://fdc.nal.usda.gov/api-key-signup.html — roughly 40 alphanumeric
// characters, no prefix.
//
// Setting it here bakes the key into the build so it survives reinstalls, which
// matters because Keychain entries don't and personal-team profiles expire
// weekly. Leave it blank to use the in-app settings screen instead; the Keychain
// always wins when both are present.
//
// Do not set this for a build you intend to give to anyone else: the key can be
// recovered from the app bundle.
USDA_API_KEY =

// Supabase, for accounts and cloud backup. Create a free project at
// https://supabase.com, then Project Settings > Data API for the URL and
// Project Settings > API Keys for the anon key.
//
// The anon key is designed to ship inside clients — it grants nothing on its
// own. Every table is protected by row-level security, so a signed-in user can
// only ever read and write their own row. See supabase/schema.sql.
//
// Leave both blank to build without accounts; the app falls back to local-only
// storage exactly as it does today.
// IMPORTANT: no https:// prefix. A double slash opens a comment in xcconfig
// files, so a full URL is silently truncated to "https:" at build time. Give
// the host only — the app adds the scheme.
//
//     SUPABASE_URL = abcdefgh.supabase.co
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Set to YES only once Apple is configured as a provider in the Supabase
// dashboard. That needs a Services ID, Team ID, Key ID and a .p8 key from
// developer.apple.com, all of which require a paid Apple Developer Program
// membership. Left blank, the Apple button is hidden and email and Google
// still work.
SUPABASE_APPLE_SIGN_IN =
